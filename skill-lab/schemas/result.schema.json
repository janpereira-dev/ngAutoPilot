  "$id": "https://ngautopilot.dev/schemas/skill-lab/result.schema.json",
  "type": "object",
  "required": ["id", "passed", "hardScore", "softScore", "criticalFailure"],
  "properties": {
    "id": { "type": "string" },
    "passed": { "type": "boolean" },
    "hardScore": { "type": "number" },
