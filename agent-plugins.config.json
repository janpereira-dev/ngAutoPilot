{
  "$schemaVersion": "1.0.0",
  "plugins": [
    {
      "name": "ngautopilot-core",
      "kind": "skills",
      "pack": "ngautopilot-core",
      "enabled": true
    },
    {
      "name": "ngautopilot-angular-architecture",
      "kind": "skills",
      "pack": "ngautopilot-angular-foundations",
      "enabled": true
    },
    {
      "name": "ngautopilot-angular-testing",
      "kind": "skills",
      "pack": "ngautopilot-angular-testing",
      "enabled": true
    },
    {
      "name": "ngautopilot-angular-21-to-22",
      "kind": "skills",
      "pack": "ngautopilot-angular-21-to-22",
      "portableNames": {
        "angular.upgrades.21-to-22.angular-21-to-22-post-upgrade-validation-gate": "angular-21-to-22-post-upgrade-validation"
      },
      "enabled": true
    },
    {
      "name": "ngautopilot-tools",
      "kind": "mcp",
      "enabled": true
    }
  ]
}
