# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF for source
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Force LF for scripts
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.svg binary
*.otf binary
*.ico binary