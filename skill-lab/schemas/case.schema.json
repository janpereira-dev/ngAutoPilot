{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngautopilot.dev/schemas/skill-lab/case.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "taskType", "criticality", "input", "expected", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "taskType": { "type": "string" },
    "criticality": { "enum": ["normal", "critical"] },
    "checks": { "type": "array", "minItems": 1 }
  }
}
